<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Палитра (как в согласованном макете) ===== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#245EDB"/>
    <SolidColorBrush x:Key="WindowBodyBrush" Color="#ECE9D8"/>
    <SolidColorBrush x:Key="FrameBrush" Color="#0A246A"/>
    <SolidColorBrush x:Key="InsetBorderBrush" Color="#7F9DB9"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#C9C5B3"/>
    <SolidColorBrush x:Key="TextBrush" Color="#10202C"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#4D4A3F"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#316AC5"/>

    <LinearGradientBrush x:Key="TitleBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3D7BEA" Offset="0"/>
        <GradientStop Color="#245EDB" Offset="0.45"/>
        <GradientStop Color="#1C4DB8" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#ECEBE6" Offset="0.85"/>
        <GradientStop Color="#D6D0C5" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===== Кнопки заголовка окна ===== -->
    <Style x:Key="TitleButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Margin" Value="2,0,0,0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="#2E6BE6" BorderBrush="White" BorderThickness="1" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#4A86F2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleCloseButton" TargetType="{x:Type Button}" BasedOn="{StaticResource TitleButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="#C8402A" BorderBrush="White" BorderThickness="1" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E0583F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Окно в стиле XP ===== -->
    <Style x:Key="XpWindow" TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{StaticResource WindowBodyBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Tahoma, Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="30" ResizeBorderThickness="6" GlassFrameThickness="0"
                              CornerRadius="0" UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Window}">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource FrameBrush}" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Top" Height="30" Background="{StaticResource TitleBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Margin="10,0,8,0" Width="16" Height="16" Stretch="Uniform"
                                          Stroke="White" StrokeThickness="2" VerticalAlignment="Center"
                                          Data="M3,12 L7,12 L10,5 L14,19 L17,12 L21,12"/>
                                    <TextBlock Grid.Column="1" Text="{TemplateBinding Title}" Foreground="White"
                                               FontWeight="Bold" FontSize="14" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,5,0"
                                                VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                                        <Button x:Name="MinButton" Style="{StaticResource TitleButton}" ToolTip="Свернуть"
                                                AutomationProperties.Name="Свернуть"
                                                Command="{x:Static SystemCommands.MinimizeWindowCommand}">
                                            <Path Data="M1,8 L9,8" Stroke="White" StrokeThickness="2"/>
                                        </Button>
                                        <Button x:Name="MaxButton" Style="{StaticResource TitleButton}" ToolTip="Развернуть"
                                                AutomationProperties.Name="Развернуть"
                                                Command="{x:Static SystemCommands.MaximizeWindowCommand}">
                                            <Rectangle Width="10" Height="9" Stroke="White" StrokeThickness="1.6"/>
                                        </Button>
                                        <Button Style="{StaticResource TitleCloseButton}" ToolTip="Закрыть"
                                                AutomationProperties.Name="Закрыть"
                                                Command="{x:Static SystemCommands.CloseWindowCommand}">
                                            <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="White" StrokeThickness="2"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ContentPresenter/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="Frame" Property="Margin" Value="7"/>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="MinButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Обычная кнопка ===== -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="14,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="{StaticResource ButtonFaceBrush}" BorderBrush="#003C74"
                            BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#E59700"/>
                        </Trigger>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#9C9A8F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Плоская кнопка панели инструментов ===== -->
    <Style x:Key="ToolButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFFFFF"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#7F9DB9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="BorderBrush" Value="{StaticResource InsetBorderBrush}"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="BorderBrush" Value="{StaticResource InsetBorderBrush}"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="{x:Type TreeView}">
        <Setter Property="BorderBrush" Value="{StaticResource InsetBorderBrush}"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="#F3F1E7"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="BorderBrush" Value="#C9C5B3"/>
        <Setter Property="BorderThickness" Value="0,0,1,2"/>
    </Style>

    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusCell" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="Padding" Value="10,3"/>
    </Style>

</ResourceDictionary>
