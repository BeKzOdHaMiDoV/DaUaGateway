<local:XpWindow x:Class="DaUaGateway.Ui.PanelWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:DaUaGateway.Ui"
                Title="DaUaGateway — конвертер OPC DA → OPC UA"
                Width="620" Height="440" MinWidth="520" MinHeight="360"
                WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12,10,12,12">

        <!-- состояние -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource InsetBorderBrush}" BorderThickness="1" Padding="12,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="Lamp" Width="16" Height="16" Fill="#9C9A8F" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StateText" Text="Остановлен" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="HintText" Margin="26,4,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                           Text="Нажмите «Запустить», чтобы конвертер начал переводить выбранные теги DA в OPC UA."/>
                <Grid Margin="26,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Адрес для SCADA:" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBox Grid.Column="1" x:Name="EndpointText" IsReadOnly="True" BorderThickness="0" Padding="0" FontWeight="Bold"
                             Background="Transparent" AutomationProperties.Name="Адрес OPC UA для SCADA"/>
                    <TextBlock Grid.Row="1" Text="Переводится:" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TotalsText" Margin="0,4,0,0" Text="—"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- кнопки -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Конфигуратор" Click="OnConfiguratorClick" Margin="0,0,8,0"/>
                    <Button Content="Журнал" Click="OnLogsClick" Margin="0,0,8,0"/>
                    <Button Content="Свернуть в трей" Click="OnHideClick"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StartButton" Click="OnStartClick" MinWidth="130" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M0,0 L10,6 L0,12 Z" Fill="#1F8A3A" Width="10" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Запустить" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Click="OnStopClick" MinWidth="130" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Fill="#C8402A" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Остановить" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
            <CheckBox x:Name="AutoStartBox" Margin="0,10,0,0" Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"
                      Content="Запускать конвертер сразу при открытии программы"/>
        </StackPanel>

        <!-- DA-серверы -->
        <GroupBox Header="DA-серверы" Margin="0,10,0,0" Padding="4">
            <ListBox x:Name="SourcesList" BorderThickness="0" AutomationProperties.Name="Состояние DA-серверов"/>
        </GroupBox>
    </DockPanel>
</local:XpWindow>
